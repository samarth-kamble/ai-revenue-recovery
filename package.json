{
  "name": "ai-revenue-platform",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean",
    "infra:up": "bash infrastructure/scripts/compose.sh up -d --wait",
    "infra:down": "bash infrastructure/scripts/compose.sh down",
    "infra:reset": "bash infrastructure/scripts/compose.sh down -v",
    "infra:logs": "bash infrastructure/scripts/compose.sh logs -f",
    "infra:ps": "bash infrastructure/scripts/compose.sh ps",
    "infra:check": "bash infrastructure/scripts/check-connectivity.sh",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @workspace/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @workspace/database db:migrate:status",
    "db:validate": "pnpm --filter @workspace/database db:validate",
    "db:studio": "pnpm --filter @workspace/database db:studio",
    "db:reset": "pnpm --filter @workspace/database db:reset"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
