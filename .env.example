# =============================================================================
# AI Revenue Recovery Platform — Environment Variables (EXAMPLE / TEMPLATE)
# -----------------------------------------------------------------------------
# This file is COMMITTED and is the canonical list of variables the platform
# expects. It must never contain real secrets.
#
# Local setup:
#     cp .env.example .env      # then fill in real values (e.g. LLM_API_KEY)
#
# Precedence:  process env  >  service .env.local  >  root .env  >  defaults
# `.env`, `.env.local`, and all other `.env.*` files are git-ignored;
# only `.env.example` is tracked.
#
# NOTE: These reflect the TARGET infrastructure from PROJECT_SPEC.md. Individual
# variables become live as the services that consume them are built. Defaults
# below assume the local docker-compose stack (added in a later phase).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL — transactional source of truth + audit --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revenue_recovery
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_recovery

# --- Redis — distributed locks, idempotency keys, cache --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Kafka — domain event backbone -----------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ai-revenue-recovery

# --- Temporal — durable recovery workflows ---------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=recovery

# --- ClickHouse — analytics / OLAP -----------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=analytics

# --- Object storage (S3-compatible / MinIO) — ML artifacts -----------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ml-artifacts

# --- LLM provider — AI recovery agent --------------------------------------
# Do NOT commit a real key. Set this only in your local .env.
LLM_API_KEY=
LLM_MODEL=

# --- Internal service URLs (Python services under services/) ---------------
ML_INFERENCE_URL=http://localhost:8001
AI_AGENT_URL=http://localhost:8002
